{
  "name": "cosmic-drift",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "description": "Cosmic Drift: 2.5D sci-fi platformer with cross-play co-op",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/screen-orientation": "8.0.2",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "peerjs": "1.5.5",
    "phaser": "4.2.1",
    "preact": "11.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@capacitor/android": "8.6.2",
    "@capacitor/cli": "8.6.2",
    "@playwright/test": "1.65.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.3",
    "dependency-cruiser": "18.9.0",
    "eslint": "10.15.0",
    "fast-check": "4.11.0",
    "ffmpeg-static": "5.3.0",
    "javascript-obfuscator": "5.10.1",
    "peer": "1.0.2",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "stub:scan": "node tools/stub-scan/stub-scan.mjs",
    "test": "vitest run tests/unit tests/sim tests/input tests/net",
    "test:golden": "vitest run tests/golden",
    "test:e2e": "vite build && playwright test",
    "levels:lint": "tsx tools/levels-lint/main.ts",
    "assets:fetch": "tsx tools/assets-fetch/main.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run deps:check && npm run stub:scan && npm run test && npm run test:golden && npm run levels:lint && npm run build",
    "replay:run": "tsx tools/replay-run/main.ts",
    "golden:record": "tsx tools/replay-run/record-golden.ts",
    "perf:bench": "tsx tools/perf-bench/main.ts"
  }
}
