{
  "name": "cosmic-drift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.21.3",
  "engines": {
    "node": ">=24.0.0 <27.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests tools *.ts *.js",
    "format:check": "prettier --check .",
    "deps:check": "depcruise --config .dependency-cruiser.cjs src",
    "stub:scan": "node tools/stub-scan.mjs",
    "test": "vitest run",
    "test:golden": "vitest run --passWithNoTests tests/golden",
    "test:e2e": "playwright test",
    "replay:run": "node tools/replay-run.ts",
    "test:visual": "playwright test --grep @visual",
    "test:a11y": "playwright test --grep @a11y",
    "levels:lint": "node tools/levels-lint.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run deps:check && npm run stub:scan && npm run test && npm run test:golden && npm run levels:lint && npm run build"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.7",
    "dependency-cruiser": "18.9.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
